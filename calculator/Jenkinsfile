
pipeline {
    agent any

    environment {
        DOCKERHUB_USER = 'sidgoswami725'
        IMAGE_NAME = 'sidgoswami725/calculator-api'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build') {
            steps {
                dir('calculator') {
                    bat '.\\mvnw.cmd -B clean package -DskipTests'
                }
            }
        }

        stage('Test') {
            steps {
                dir('calculator') {
                    bat '.\\mvnw.cmd -B test'
                }
            }
            post {
                always {
                    junit testResults: 'calculator/target/surefire-reports/*.xml',
                          allowEmptyResults: false
                }
            }
        }

        stage('Docker Build') {
            steps {
                dir('calculator') {
                    bat 'docker build -t %IMAGE_NAME%:%BUILD_NUMBER% -t %IMAGE_NAME%:latest .'
                }
            }
        }

        stage('Push') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'dockerhub-creds',
                        usernameVariable: 'DH_USER',
                        passwordVariable: 'DH_TOKEN'
                    )
                ]) {
                    bat '''
                        @echo off
                        echo %DH_TOKEN%| docker login --username %DH_USER% --password-stdin
                        if errorlevel 1 exit /b 1
                        docker push %IMAGE_NAME%:%BUILD_NUMBER%
                        if errorlevel 1 exit /b 1
                        docker push %IMAGE_NAME%:latest
                        if errorlevel 1 exit /b 1
                        docker logout
                    '''
                }
            }
        }

        stage('Deploy') {
            steps {
                dir('calculator') {
                    bat '"C:\\Users\\Sid\\AppData\\Local\\Programs\\DockerDesktop\\resources\\cli-plugins\\docker-compose.exe" pull'
                    bat '"C:\\Users\\Sid\\AppData\\Local\\Programs\\DockerDesktop\\resources\\cli-plugins\\docker-compose.exe" up -d'
                    bat '"C:\\Users\\Sid\\AppData\\Local\\Programs\\DockerDesktop\\resources\\cli-plugins\\docker-compose.exe" ps'
        
                    powershell '''
                        $ErrorActionPreference = "Stop"
                        $healthy = $false
        
                        for ($i = 0; $i -lt 12; $i++) {
                            try {
                                $r = Invoke-RestMethod "http://localhost/actuator/health" -TimeoutSec 5
                                if ($r.status -eq "UP") {
                                    $healthy = $true
                                    break
                                }
                            } catch {}
                            Start-Sleep -Seconds 5
                        }
        
                        if (-not $healthy) {
                            & "C:\\Users\\Sid\\AppData\\Local\\Programs\\DockerDesktop\\resources\\cli-plugins\\docker-compose.exe" logs --tail=100
                            throw "Calculator health check failed"
                        }
        
                        Write-Host "Calculator API is healthy."
                    '''
                }
            }
        }
    }
    
post {
    success {
        emailext(
            to: 'goswamisiddharth377@gmail.com',
            subject: "SUCCESS: ${env.JOB_NAME} #${env.BUILD_NUMBER}",
            body: """Build succeeded.

Job: ${env.JOB_NAME}
Build: #${env.BUILD_NUMBER}
Details: ${env.BUILD_URL}"""
        )
    }

    failure {
        emailext(
            to: 'goswamisiddharth377@gmail.com',
            subject: "FAILURE: ${env.JOB_NAME} #${env.BUILD_NUMBER}",
            body: """Build failed.

Job: ${env.JOB_NAME}
Build: #${env.BUILD_NUMBER}
Details: ${env.BUILD_URL}"""
        )
    }
}

}


